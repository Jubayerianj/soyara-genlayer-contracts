# GenLayer Bradbury Testnet RPC
NEXT_PUBLIC_RPC_URL=https://rpc-bradbury.genlayer.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer-bradbury.genlayer.com

# Optional Server-Side Private Keys (for real on-chain automated execution)
# If left unset, the keeper operates in simulation/client mode.
GENLAYER_AGENT_PRIVATE_KEY=
EVM_EXECUTOR_PRIVATE_KEY=

# Polling Interval in milliseconds (default: 4000)
KEEPER_POLL_INTERVAL_MS=4000
